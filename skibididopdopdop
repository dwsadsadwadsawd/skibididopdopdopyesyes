-- Scan for potential hide spots (corners, behind objects)
local function ScanForHideSpots()
    HideSpots = {}
    
    -- Look for large objects to hide behind
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Size.Magnitude > 5 and not obj.Anchored then
            -- Found a potential hiding spot
            table.insert(HideSpots, {
                Position = obj.Position + (obj.CFrame.LookVector * 3),
                Object = obj
            })
        end
    end
    
    -- Add some random spots if none found
    if #HideSpots == 0 then
        for i = 1, 5 do
            table.insert(HideSpots, {
                Position = Root.Position + Vector3.new(
                    math.random(-30, 30),
                    0,
                    math.random(-30, 30)
                )
            })
        end
    end
end

-- Find nearest hide spot
local function FindNearestHideSpot()
    local nearest = nil
    local nearestDist = math.huge
    
    for _, spot in ipairs(HideSpots) do
        local dist = (spot.Position - Root.Position).Magnitude
        if dist < nearestDist and dist > 5 then
            nearestDist = dist
            nearest = spot.Position
        end
    end
    
    return nearest
end

-- Look at target using body rotation
local function LookAt(targetPos)
    if not Root or not targetPos then return end
    
    local direction = (targetPos - Root.Position).Unit
    local angle = math.atan2(-direction.X, -direction.Z)
    
    -- Smoothly set target angle
    BodyTargetAngle = angle
end

-- Look around at nearby objects
local function LookAround()
    -- Find something interesting to look at
    local lookTargets = {}
    
    -- Look at other players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                table.insert(lookTargets, char.HumanoidRootPart.Position)
            end
        end
    end
    
    -- Look at large objects
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Size.Magnitude > 10 then
            table.insert(lookTargets, obj.Position)
        end
    end
    
    if #lookTargets > 0 then
        AILookTarget = lookTargets[math.random(#lookTargets)]
        LookAt(AILookTarget)
        AILookTimer = AILookDuration
    end
end

-- Walk to target
local function WalkTo(targetPos, stopDistance)
    stopDistance = stopDistance or 3
    if not Root or not targetPos then return false end
    
    local direction = (targetPos - Root.Position).Unit
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Look in the direction we're walking
    LookAt(targetPos)
    
    -- Move using BodyVelocity for smooth movement
    if not BodyVelocity then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        BodyVelocity.P = 1e6
        BodyVelocity.Parent = Root
    end
    
    BodyVelocity.Velocity = direction * AIWalkSpeed
    
    return distance <= stopDistance
end

-- Stop moving
local function StopMoving()
    if BodyVelocity then
        BodyVelocity.Velocity = Vector3.zero
    end
end

-- Sit down
local function SitDown()
    if Hum and not Hum.Sit then
        Hum.Sit = true
    end
end

-- Stand up
local function StandUp()
    if Hum and Hum.Sit then
        Hum.Sit = false
    end
end

-- ==============================================
-- AI MODE FUNCTIONS
-- ==============================================

-- Explore Mode - Wander around looking at things
local function ExploreMode(dt)
    if AIState == "idle" then
        -- Pick a random direction to explore
        AITargetPosition = Root.Position + Vector3.new(
            math.random(-AIExploreRadius, AIExploreRadius),
            0,
            math.random(-AIExploreRadius, AIExploreRadius)
        )
        AIState = "walking"
        if SCB then SCB("AI: Exploring...") end
    end
    
    if AIState == "walking" then
        local reached = WalkTo(AITargetPosition)
        
        -- Look around while walking
        if AILookTimer <= 0 then
            LookAround()
        else
            AILookTimer = AILookTimer - dt
        end
        
        if reached then
            AIState = "looking"
            AIActionTimer = 2
            LookAround()
        end
    end
    
    if AIState == "looking" then
        AIActionTimer = AIActionTimer - dt
        if AIActionTimer <= 0 then
            AIState = "idle"
        end
    end
end

-- Follow Mode - Follow selected player
local function FollowMode(dt)
    if not AITargetPlayer then
        if SCB then SCB("AI: No target to follow") end
        AIMode = "explore"
        return
    end
    
    local char = AITargetPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        AIMode = "explore"
        return
    end
    
    local targetPos = char.HumanoidRootPart.Position
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Look at the target
    LookAt(targetPos + Vector3.new(0, 3, 0))
    
    if distance > AIFollowDistance then
        -- Follow the target
        WalkTo(targetPos, AIFollowDistance)
        AIState = "following"
        if SCB then SCB("AI: Following " .. AITargetPlayer.Name) end
    else
        -- Close enough, just watch
        StopMoving()
        AIState = "watching"
    end
end

-- Hide Mode - Find and hide behind objects
local function HideMode(dt)
    if AIState == "idle" then
        -- Find a hiding spot
        AIHideSpot = FindNearestHideSpot()
        if AIHideSpot then
            AITargetPosition = AIHideSpot
            AIState = "hiding"
            if SCB then SCB("AI: Hiding...") end
        else
            -- No hiding spots, just crouch
            AIState = "crouching"
        end
    end
    
    if AIState == "hiding" then
        local reached = WalkTo(AITargetPosition, 2)
        
        if reached then
            -- Found hiding spot, crouch and look around
            StopMoving()
            AIState = "hidden"
            AIActionTimer = 5
            LookAround()
        end
    end
    
    if AIState == "hidden" then
        AIActionTimer = AIActionTimer - dt
        if AILookTimer <= 0 then
            -- Look around while hidden
            LookAround()
        else
            AILookTimer = AILookTimer - dt
        end
        
        -- Check if someone is nearby
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - Root.Position).Magnitude
                    if dist < 10 then
                        -- Someone is close, stay hidden
                        if SCB then SCB("AI: Someone nearby - staying hidden") end
                    end
                end
            end
        end
        
        if AIActionTimer <= 0 then
            -- Time to find a new hiding spot
            AIState = "idle"
        end
    end
end

-- Sit Mode - Find someone sitting and join them
local function SitMode(dt)
    -- Look for sitting players
    local sittingPlayer = nil
    local sittingPos = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Sit then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        sittingPlayer = plr
                        sittingPos = rootPart.Position
                        break
                    end
                end
            end
        end
    end
    
    if sittingPlayer then
        -- Found someone sitting
        local distance = (sittingPos - Root.Position).Magnitude
        
        if distance > 3 then
            -- Walk to them
            WalkTo(sittingPos, 2)
            LookAt(sittingPos + Vector3.new(0, 3, 0))
            AIState = "walking_to_sit"
            if SCB then SCB("AI: Walking to sit with " .. sittingPlayer.Name) end
        else
            -- Sit down next to them
            StopMoving()
            SitDown()
            AIState = "sitting"
            AIActionTimer = AISitDuration
            -- Look at them
            LookAt(sittingPos + Vector3.new(0, 3, 0))
        end
    else
        -- No one sitting, just explore
        if AIState ~= "exploring" then
            AIState = "exploring"
        end
        ExploreMode(dt)
    end
    
    if AIState == "sitting" then
        AIActionTimer = AIActionTimer - dt
        if AIActionTimer <= 0 then
            StandUp()
            AIState = "exploring"
        end
    end
end

-- Flee Mode - Run away from threats
local function FleeMode(dt)
    if AIFleeTimer > 0 then
        AIFleeTimer = AIFleeTimer - dt
        
        -- Find direction away from nearest player
        local fleeDirection = Vector3.new(1, 0, 0)
        local nearestDist = math.huge
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local pos = char.HumanoidRootPart.Position
                    local dist = (pos - Root.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        fleeDirection = (Root.Position - pos).Unit
                    end
                end
            end
        end
        
        -- Run away
        AITargetPosition = Root.Position + fleeDirection * 50
        WalkTo(AITargetPosition, 5)
        AIState = "fleeing"
        
        if SCB then SCB("AI: Fleeing! " .. math.floor(AIFleeTimer) .. "s left") end
    else
        -- Done fleeing
        AIMode = "explore"
        AIState = "idle"
    end
end

-- Main AI update
local function UpdateAI(dt)
    if not St.AIControl or not Root or not Hum then return end
    
    -- Check for damage (would need health monitoring in real implementation)
    -- For demo, we'll simulate with a key press or something
    
    -- Run current mode
    if AIMode == "explore" then
        ExploreMode(dt)
    elseif AIMode == "follow" then
        FollowMode(dt)
    elseif AIMode == "hide" then
        HideMode(dt)
    elseif AIMode == "sit" then
        SitMode(dt)
    elseif AIMode == "flee" then
        FleeMode(dt)
    end
end

-- Set AI Mode
local function SetAIMode(mode)
    AIMode = mode
    AIState = "idle"
    StopMoving()
    StandUp()
    
    if mode == "explore" then
        ScanForHideSpots()
        if SCB then SCB("AI Mode: Explore - Wandering around") end
    elseif mode == "follow" then
        if AITargetPlayer then
            if SCB then SCB("AI Mode: Follow - Following " .. AITargetPlayer.Name) end
        else
            if SCB then SCB("AI Mode: Follow - Select a player first") end
        end
    elseif mode == "hide" then
        ScanForHideSpots()
        if SCB then SCB("AI Mode: Hide - Finding places to hide") end
    elseif mode == "sit" then
        if SCB then SCB("AI Mode: Sit - Looking for sitting players") end
    elseif mode == "flee" then
        AIFleeTimer = AIFleeDuration
        if SCB then SCB("AI Mode: Flee - Running away!") end
    end
end

-- Toggle AI Control
local function ToggleAIControl()
    if St.AIControl then
        -- Disable conflicting features
        if St.Fly then
            St.Fly = false
            ToggleFly()
        end
        
        -- Initialize AI
        ScanForHideSpots()
        SetAIMode("explore")
        
        -- Main AI loop
        AIConnection = RunService.Heartbeat:Connect(function(dt)
            UpdateAI(dt)
        end)
        table.insert(CN, AIConnection)
        
        if SCB then SCB("AI Control enabled - Mode: Explore") end
        
    elseif AIConnection then
        AIConnection:Disconnect()
        AIConnection = nil
        
        -- Clean up
        StopMoving()
        StandUp()
        BodyTargetAngle = 0
        
        if SCB then SCB("AI Control disabled") end
    end
end


-- WINDOW DRAG
-- ==============================================
local winDrag = false
local wDS = nil
local wDP = nil

MF.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        winDrag = true
        wDS = i.Position
        wDP = MF.Position
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseMovement then
        if winDrag then
            local d = i.Position - wDS
            MF.Position = UDim2.new(wDP.X.Scale, wDP.X.Offset + d.X, wDP.Y.Scale, wDP.Y.Offset + d.Y)
        end
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        winDrag = false
    end
end)

-- Unload keybind
UserInputService.InputBegan:Connect(function(i, con)
    if con then return end
    if i.KeyCode == Enum.KeyCode.Zero then UL() end
end)


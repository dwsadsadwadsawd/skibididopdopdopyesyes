-- ==============================================
-- REVERSE CONTROLS
-- ==============================================
local function ToggleReverseControls()
    if St.ReverseControls then
        ReverseControlsConnection = RunService.Heartbeat:Connect(function()
            if not St.ReverseControls or not BodyVelocity then return end
            
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir - Camera.CFrame.LookVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir + Camera.CFrame.LookVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir + Camera.CFrame.RightVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir - Camera.CFrame.RightVector * FlySpeed end
            
            if St.Fly and BodyVelocity then
                BodyVelocity.Velocity = moveDir
            end
        end)
        table.insert(CN, ReverseControlsConnection)
    elseif ReverseControlsConnection then
        ReverseControlsConnection:Disconnect()
        ReverseControlsConnection = nil
    end
end

-- ==============================================
-- DRUNK MODE
-- ==============================================
local function ToggleDrunkMode()
    if St.DrunkMode then
        DrunkModeConnection = RunService.Heartbeat:Connect(function()
            if not St.DrunkMode or not Root then return end
            
            local wobble = math.sin(tick() * 5) * 0.1
            Root.CFrame = Root.CFrame * CFrame.Angles(wobble, wobble * 2, wobble)
        end)
        table.insert(CN, DrunkModeConnection)
    elseif DrunkModeConnection then
        DrunkModeConnection:Disconnect()
        DrunkModeConnection = nil
    end
end

-- ==============================================
-- RUBBER BAND
-- ==============================================
local function ToggleRubberBand()
    if St.RubberBand then
        local startPos = Root and Root.Position
        
        RubberBandConnection = RunService.Heartbeat:Connect(function()
            if not St.RubberBand or not Root or not startPos then return end
            
            local dist = (Root.Position - startPos).Magnitude
            if dist > 20 then
                local direction = (startPos - Root.Position).Unit
                Root.CFrame = CFrame.new(Root.Position + direction * dist * 0.1)
            end
        end)
        table.insert(CN, RubberBandConnection)
    elseif RubberBandConnection then
        RubberBandConnection:Disconnect()
        RubberBandConnection = nil
    end
end

-- ==============================================
-- SCREEN SHAKE
-- ==============================================
local function ToggleScreenShake()
    if St.ScreenShake then
        local originalCFrame = Camera.CFrame
        
        ScreenShakeConnection = RunService.RenderStepped:Connect(function()
            if not St.ScreenShake or not Camera then return end
            
            local shake = Vector3.new(
                math.random(-1, 1) * 0.5,
                math.random(-1, 1) * 0.5,
                math.random(-1, 1) * 0.5
            )
            Camera.CFrame = originalCFrame * CFrame.new(shake)
        end)
        table.insert(CN, ScreenShakeConnection)
    elseif ScreenShakeConnection then
        ScreenShakeConnection:Disconnect()
        ScreenShakeConnection = nil
    end
end

-- ==============================================
-- GRAVITY FLIP
-- ==============================================
local function ToggleGravityFlip()
    if St.GravityFlip then
        OriginalGravity = WS.Gravity
        WS.Gravity = -WS.Gravity or -196.2
    else
        WS.Gravity = OriginalGravity or 196.2
    end
end

-- ==============================================
-- UNLOAD FUNCTION
-- ==============================================
local function UL()
    St.Fly = false; ToggleFly()
    St.Noclip = false; ToggleNoclip()
    St.Walkspeed = false; SetWalkspeed()
    St.Jumppower = false; SetJumppower()
    St.InfiniteJump = false; ToggleInfiniteJump()
    St.FakeLag = false; ToggleFakeLag()
    St.WifiLag = false; ToggleWifiLag()
    St.AnchorInterval = false; ToggleAnchorInterval()
    St.SpinBot = false; ToggleSpinBot()
    St.SitSpin = false; ToggleSitSpin()
    St.Float = false; ToggleFloat()
    St.AntiGravity = false; ToggleAntiGravity()
    St.ReverseControls = false; ToggleReverseControls()
    St.DrunkMode = false; ToggleDrunkMode()
    St.RubberBand = false; ToggleRubberBand()
    St.ScreenShake = false; ToggleScreenShake()
    St.GravityFlip = false; ToggleGravityFlip()
    
    for _, c in ipairs(CN) do
        pcall(function() c:Disconnect() end)
    end
    CN = {}
    
    if PGui:FindFirstChild("FunHub") then
        PGui.FunHub:Destroy()
    end
    
    WS.Gravity = 196.2
    
    print("[Fun Hub] Unloaded")
end

if PGui:FindFirstChild("FunHub") then UL() end


-- ==============================================
-- IMPROVED FAKE LAG (More believable)
-- ==============================================
local function ToggleFakeLag()
    if St.FakeLag then
        local lastUpdate = tick()
        local lagTimer = 0
        local isLagging = false
        
        FakeLagConnection = RunService.Heartbeat:Connect(function(deltaTime)
            if not St.FakeLag then return end
            
            lagTimer = lagTimer + deltaTime
            
            -- Create a pattern: 0.5 sec normal, 0.3 sec lag, repeat
            if not isLagging and lagTimer > 0.5 then
                isLagging = true
                lagTimer = 0
                -- Freeze everything temporarily
                if BodyVelocity then
                    BodyVelocity.Velocity = Vector3.zero
                end
            elseif isLagging and lagTimer > LagInterval then
                isLagging = false
                lagTimer = 0
            end
            
            -- During lag, delay all updates
            if isLagging then
                wait(LagInterval * 0.5) -- Micro-freeze during lag
            end
        end)
        table.insert(CN, FakeLagConnection)
        
        -- Also add network lag simulation
        local networkLag = RunService.Heartbeat:Connect(function()
            if not St.FakeLag then return end
            if math.random() < 0.3 then -- 30% chance to drop a packet
                wait(LagInterval * 0.2)
            end
        end)
        table.insert(CN, networkLag)
        
    elseif FakeLagConnection then
        FakeLagConnection:Disconnect()
        FakeLagConnection = nil
    end
end

-- ==============================================
-- WIFI LAG (Rubberbanding)
-- ==============================================
local function ToggleWifiLag()
    if St.WifiLag then
        local lastPos = Root and Root.Position
        local rubberBandAmount = 0
        
        WifiLagConnection = RunService.Heartbeat:Connect(function()
            if not St.WifiLag or not Root then return end
            
            rubberBandAmount = rubberBandAmount + 1
            
            -- Every 10 frames, do a rubberband effect
            if rubberBandAmount >= 10 then
                rubberBandAmount = 0
                if lastPos then
                    -- Snap back to previous position (rubberbanding)
                    Root.CFrame = CFrame.new(lastPos)
                end
            end
            
            -- Random teleports within range (wifi lag spikes)
            if math.random() < 0.2 then -- 20% chance
                local offset = Vector3.new(
                    math.random(-WifiLagStrength, WifiLagStrength),
                    math.random(-WifiLagStrength/2, WifiLagStrength/2),
                    math.random(-WifiLagStrength, WifiLagStrength)
                )
                Root.CFrame = CFrame.new(Root.Position + offset)
            end
            
            lastPos = Root.Position
        end)
        table.insert(CN, WifiLagConnection)
    elseif WifiLagConnection then
        WifiLagConnection:Disconnect()
        WifiLagConnection = nil
    end
end


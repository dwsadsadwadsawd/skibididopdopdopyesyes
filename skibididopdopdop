-- Explore Mode - Wander around looking at things
local function ExploreMode(dt)
    -- Scan for points of interest periodically
    if math.random() < 0.01 then
        ScanPointsOfInterest()
    end
    
    if AIState == "idle" then
        -- Pick a random point to explore that's not too close
        local attempts = 0
        repeat
            AITargetPosition = Root.Position + Vector3.new(
                math.random(-AIExploreRadius, AIExploreRadius),
                0,
                math.random(-AIExploreRadius, AIExploreRadius)
            )
            attempts = attempts + 1
        until (AITargetPosition - Root.Position).Magnitude > 10 or attempts > 5
        
        AIState = "walking"
        AIWaitTime = 0
        AIActionTimer = 0
        if SCB then SCB("Exploring new area...") end
    end
    
    if AIState == "walking" then
        AIActionTimer = AIActionTimer + dt
        local reached = WalkToTargetImproved(AITargetPosition, dt)
        
        -- Look around while walking
        if math.random() < 0.02 then
            LookAround(dt)
        end
        
        if reached then
            AIState = "looking"
            AIActionTimer = math.random(2, 4) -- Random look time
            if SCB then SCB("Reached destination - looking around") end
        elseif AIPathBlocked and AIActionTimer > 5 then
            -- Been trying to reach target for too long, give up
            AIState = "waiting"
            AIWaitTime = math.random(2, 4)
            if SCB then SCB("Path blocked too long - waiting") end
        end
    end
    
    if AIState == "waiting" then
        AIWaitTime = AIWaitTime - dt
        LookAround(dt)
        if AIWaitTime <= 0 then
            AIState = "idle"
            AIPathBlocked = false
        end
    end
    
    if AIState == "looking" then
        AIActionTimer = AIActionTimer - dt
        LookAround(dt)
        if AIActionTimer <= 0 then
            AIState = "idle"
        end
    end
end

-- Follow Mode - Follow selected player with pathfinding
local function FollowMode(dt)
    if not AITargetPlayer then
        if SCB then SCB("No target to follow") end
        AIMode = "explore"
        return
    end
    
    local char = AITargetPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        AIMode = "explore"
        return
    end
    
    local targetPos = char.HumanoidRootPart.Position
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Scan for points of interest periodically
    if math.random() < 0.02 then
        ScanPointsOfInterest()
    end
    
    if distance > AIFollowDistance + 5 then -- Add buffer to prevent constant switching
        -- Try to follow the target
        AIActionTimer = AIActionTimer + dt
        local reached = WalkToTargetImproved(targetPos, dt)
        
        if AIPathBlocked and AIActionTimer > 3 then
            -- Path blocked for too long, just stand and look at target
            if Hum then 
                Hum:MoveTo(Root.Position)
                Hum.WalkSpeed = 16 -- Reset to normal speed
            end
            SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
            AIState = "waiting"
            AIActionTimer = 0
            if SCB then SCB("Can't reach " .. AITargetPlayer.Name .. " - watching from distance") end
        else
            AIState = "following"
            -- Look at target while following
            SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
        end
    elseif distance < AIFollowDistance - 2 then -- Too close, back away a bit
        local awayDirection = (Root.Position - targetPos).Unit
        local backAwayPos = Root.Position + awayDirection * 3
        if Hum then
            Hum.WalkSpeed = AIWalkSpeed * 0.5 -- Move slower when backing away
            Hum:MoveTo(backAwayPos)
        end
        SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
        AIState = "adjusting_distance"
    else
        -- Perfect distance, just watch
        if Hum then 
            Hum:MoveTo(Root.Position)
            Hum.WalkSpeed = 16
        end
        SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
        AIState = "watching"
        AIActionTimer = 0
    end
    
    -- Also look around occasionally while following
    if math.random() < 0.005 and AIState == "watching" then
        LookAround(dt)
    end
end

-- Hide Mode - Find and hide behind objects
local function HideMode(dt)
    if AIState == "idle" then
        -- Find a hiding spot (simplified)
        AIHideSpot = Root.Position + Vector3.new(
            math.random(-20, 20),
            0,
            math.random(-20, 20)
        )
        AITargetPosition = AIHideSpot
        AIState = "hiding"
        if SCB then SCB("Hiding...") end
    end
    
    if AIState == "hiding" then
        local reached = WalkToTargetImproved(AITargetPosition, dt)
        
        if reached then
            -- Found hiding spot, stop and look around
            StopMoving()
            AIState = "hidden"
            AIActionTimer = 5
        end
    end
    
    if AIState == "hidden" then
        AIActionTimer = AIActionTimer - dt
        LookAround(dt)
        
        if AIActionTimer <= 0 then
            AIState = "idle"
        end
    end
end

-- Sit Mode - Find someone sitting and join them
local function SitMode(dt)
    -- Look for sitting players
    local sittingPlayer = nil
    local sittingPos = nil
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Sit then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        sittingPlayer = plr
                        sittingPos = rootPart.Position
                        break
                    end
                end
            end
        end
    end
    
    if sittingPlayer then
        -- Found someone sitting
        local distance = (sittingPos - Root.Position).Magnitude
        
        if distance > 3 then
            -- Walk to them
            WalkToTargetImproved(sittingPos, dt)
            SmoothLookAt(sittingPos + Vector3.new(0, 3, 0), dt)
            AIState = "walking_to_sit"
            if SCB then SCB("Walking to sit with " .. sittingPlayer.Name) end
        else
            -- Sit down next to them and jump first
            StopMoving()
            if Hum and not Hum.Sit then
                -- Jump before sitting
                Hum:ChangeState(Enum.HumanoidStateType.Jumping)
                wait(0.5) -- Wait a bit for jump
                Hum.Sit = true
            end
            AIState = "sitting"
            AIActionTimer = AISitDuration
            SmoothLookAt(sittingPos + Vector3.new(0, 3, 0), dt)
            if SCB then SCB("Sitting with " .. sittingPlayer.Name) end
        end
    else
        -- No one sitting, just explore
        ExploreMode(dt)
    end
    
    if AIState == "sitting" then
        AIActionTimer = AIActionTimer - dt
        if AIActionTimer <= 0 then
            -- Jump when getting up
            if Hum and Hum.Sit then
                Hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            StandUp()
            AIState = "idle"
        end
        -- Look around while sitting
        LookAround(dt)
    end
end

-- Flee Mode - Run away from threats
local function FleeMode(dt)
    if AIFleeTimer > 0 then
        AIFleeTimer = AIFleeTimer - dt
        
        -- Find direction away from nearest player
        local fleeDirection = Vector3.new(1, 0, 0)
        local nearestDist = math.huge
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local pos = char.HumanoidRootPart.Position
                    local dist = (pos - Root.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        fleeDirection = (Root.Position - pos).Unit
                    end
                end
            end
        end
        
        -- Run away
        AITargetPosition = Root.Position + fleeDirection * 50
        WalkToTargetImproved(AITargetPosition, dt)
        AIState = "fleeing"
        
        if SCB then SCB("Fleeing! " .. math.floor(AIFleeTimer) .. "s left") end
    else
        -- Done fleeing
        AIMode = "explore"
        AIState = "idle"
    end
end

-- Defense Mode - Protect selected player and shoot enemies
local function DefenseMode(dt)
    if not AIDefendTarget then
        if SCB then SCB("No target to defend") end
        AIMode = "explore"
        return
    end
    
    local char = AIDefendTarget.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        AIMode = "explore"
        return
    end
    
    local targetPos = char.HumanoidRootPart.Position
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Check for enemies near the defended player
    local nearbyEnemies = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr ~= AIDefendTarget then
            local enemyChar = plr.Character
            if enemyChar and enemyChar:FindFirstChild("HumanoidRootPart") then
                local enemyPos = enemyChar.HumanoidRootPart.Position
                local distToTarget = (enemyPos - targetPos).Magnitude
                
                if distToTarget <= AIDefendRadius then
                    -- Check if enemy has weapon
                    local hasWeapon = false
                    local weaponName = "None"
                    for _, weaponItem in ipairs(WeaponNames) do
                        if enemyChar:FindFirstChild(weaponItem) then
                            hasWeapon = true
                            weaponName = weaponItem
                            break
                        end
                    end
                    
                    -- Check team (Prison Life team check)
                    local isEnemy = true
                    if plr.Team and AIDefendTarget.Team then
                        isEnemy = plr.Team ~= AIDefendTarget.Team
                    end
                    
                    if isEnemy then
                        table.insert(nearbyEnemies, {
                            Player = plr,
                            Position = enemyPos,
                            Distance = distToTarget,
                            HasWeapon = hasWeapon,
                            WeaponName = weaponName
                        })
                    end
                end
            end
        end
    end
    
    -- Sort enemies by priority (weapon holders first, then by distance)
    table.sort(nearbyEnemies, function(a, b)
        if a.HasWeapon and not b.HasWeapon then return true end
        if not a.HasWeapon and b.HasWeapon then return false end
        return a.Distance < b.Distance
    end)
    
    -- Check if we have a weapon to shoot with
    local myWeapon = nil
    for _, weaponName in ipairs(WeaponNames) do
        if Char:FindFirstChild(weaponName) then
            myWeapon = weaponName
            break
        end
    end
    
    if #nearbyEnemies > 0 and myWeapon then
        -- Combat mode - shoot at nearest enemy
        local primaryEnemy = nearbyEnemies[1]
        AIState = "defending_combat"
        
        -- Look at enemy
        SmoothLookAt(primaryEnemy.Position + Vector3.new(0, 3, 0), dt)
        
        -- Position ourselves between enemy and defended player
        local defendPos = targetPos + (Root.Position - primaryEnemy.Position).Unit * 8
        local distToDefendPos = (defendPos - Root.Position).Magnitude
        
        if distToDefendPos > 3 then
            WalkToTargetImproved(defendPos, dt)
        else
            StopMoving()
        end
        
        -- Shoot at enemy (cooldown system)
        AIShootCooldown = AIShootCooldown - dt
        if AIShootCooldown <= 0 then
            -- Simulate shooting by clicking
            local weaponTool = Char:FindFirstChild(myWeapon)
            if weaponTool and weaponTool:IsA("Tool") then
                weaponTool:Activate()
                AIShootCooldown = 0.5 -- Half second cooldown
                if SCB then SCB("Shooting at " .. primaryEnemy.Player.Name .. " with " .. myWeapon) end
            end
        end
        
    elseif distance > AIFollowDistance then
        -- No enemies, follow defended player
        AIState = "defending_follow"
        WalkToTargetImproved(targetPos, dt)
        SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
        
    else
        -- Close to defended player, scan for threats
        AIState = "defending_watch"
        StopMoving()
        
        -- Look around for potential threats
        if #PointsOfInterest > 0 then
            LookAround(dt)
        else
            SmoothLookAt(targetPos + Vector3.new(0, 3, 0), dt)
        end
    end
    
    -- Update status
    if #nearbyEnemies > 0 then
        local enemyInfo = nearbyEnemies[1]
        local weaponInfo = enemyInfo.HasWeapon and (" [" .. enemyInfo.WeaponName .. "]") or ""
        if SCB then SCB("Defending " .. AIDefendTarget.Name .. " from " .. enemyInfo.Player.Name .. weaponInfo) end
    end
    
    -- Scan for points of interest periodically
    if math.random() < 0.05 then
        ScanPointsOfInterest()
    end
end


-- Find path to target (simplified - real pathfinding would use PathfindingService)
local function FindPathTo(targetPos)
    -- Simple direct path - in a real implementation you'd use PathfindingService
    return {targetPos}
end

-- Look at target using body rotation
local function LookAt(targetPos)
    if not Root or not targetPos then return end
    
    local direction = (targetPos - Root.Position).Unit
    local angle = math.atan2(-direction.X, -direction.Z)
    
    -- Smoothly set target angle
    BodyTargetAngle = angle
end

-- Walk to target
local function WalkTo(targetPos)
    if not Root or not targetPos then return end
    
    local direction = (targetPos - Root.Position).Unit
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Look in the direction we're walking
    LookAt(targetPos)
    
    -- Move using BodyVelocity for smooth movement
    if not BodyVelocity then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        BodyVelocity.P = 1e6
        BodyVelocity.Parent = Root
    end
    
    BodyVelocity.Velocity = direction * AIWalkSpeed
    
    if distance < 3 then
        return true -- Reached target
    end
    return false
end

-- Stop moving
local function StopMoving()
    if BodyVelocity then
        BodyVelocity.Velocity = Vector3.zero
    end
end

-- Sit down
local function SitDown()
    if Hum and not Hum.Sit then
        Hum.Sit = true
    end
end

-- Stand up
local function StandUp()
    if Hum and Hum.Sit then
        Hum.Sit = false
    end
end

-- Main AI update
local function UpdateAI(dt)
    if not St.AIControl or not Root or not Hum then return end
    
    -- Update timers
    AITimer = AITimer + dt
    if AIFleeTimer > 0 then
        AIFleeTimer = AIFleeTimer - dt
    end
    if AISitTimer > 0 then
        AISitTimer = AISitTimer - dt
    end
    
    -- Check for damage (simplified - would need health monitoring)
    -- In a real implementation, you'd connect to Hum.HealthChanged
    
    -- Priority 1: Flee if taking damage
    if AIFleeTimer > 0 then
        if AIState ~= "fleeing" then
            AIState = "fleeing"
            if SCB then SCB("AI: Taking damage - fleeing!") end
        end
        
        -- Find farthest player to flee to
        local farthestDist = 0
        local farthestPos = Root.Position + Vector3.new(50, 0, 50)
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local pos = char.HumanoidRootPart.Position
                    local dist = (pos - Root.Position).Magnitude
                    if dist > farthestDist then
                        farthestDist = dist
                        farthestPos = pos + (pos - Root.Position).Unit * 20
                    end
                end
            end
        end
        
        WalkTo(farthestPos)
        return
    end
    
    -- Priority 2: Check for sitting players
    local sittingPlr, sittingPos = CheckForSitting()
    if sittingPlr and AISitTimer <= 0 then
        if AIState ~= "sitting" then
            AIState = "sitting"
            if SCB then SCB("AI: Found sitting player - joining!") end
            AISitTimer = AISitDuration
        end
        
        -- Walk to sitting player
        local reached = WalkTo(sittingPos)
        if reached then
            SitDown()
            -- Look at the player
            LookAt(sittingPos + Vector3.new(0, 3, 0))
        end
        return
    end
    
    -- Priority 3: Look at interesting things
    if AITimer > AILookDuration then
        AITimer = 0
        ScanForPoints()
        
        if #InterestPoints > 0 then
            local randomPoint = InterestPoints[math.random(#InterestPoints)]
            AILookTarget = randomPoint.Position
            AIState = "looking"
            if SCB then SCB("AI: Looking at something...") end
        end
    end
    
    if AIState == "looking" and AILookTarget then
        LookAt(AILookTarget)
        
        -- Stop looking after a moment
        if AITimer > 1 then
            AIState = "walking"
        end
    end
    
    -- Priority 4: Wander around
    if AIState == "idle" or AIState == "walking" then
        if not AITargetPosition or (Root.Position - AITargetPosition).Magnitude < 5 then
            -- Pick new random destination
            AITargetPosition = Root.Position + Vector3.new(
                math.random(-30, 30),
                0,
                math.random(-30, 30)
            )
            AIState = "walking"
            if SCB then SCB("AI: Wandering...") end
        end
        
        WalkTo(AITargetPosition)
    end
end

-- Damage detection setup
local function SetupDamageDetection()
    if Hum then
        local lastHealth = Hum.Health
        
        Hum.HealthChanged:Connect(function(newHealth)
            if St.AIControl and newHealth < lastHealth then
                -- Taking damage!
                AIFleeTimer = AIFleeDuration
                if SCB then SCB("AI: Ouch! Fleeing for " .. AIFleeDuration .. " seconds") end
            end
            lastHealth = newHealth
        end)
    end
end

-- Toggle AI Control
local function ToggleAIControl()
    if St.AIControl then
        -- Disable conflicting features
        if St.Fly then
            St.Fly = false
            ToggleFly()
        end
        
        -- Initialize AI
        AIState = "idle"
        AITimer = 0
        AIFleeTimer = 0
        AISitTimer = 0
        ScanForPoints()
        SetupDamageDetection()
        
        -- Main AI loop
        AIConnection = RunService.Heartbeat:Connect(function(dt)
            UpdateAI(dt)
        end)
        table.insert(CN, AIConnection)
        
        if SCB then SCB("AI Control enabled - Watching for damage, sitting players") end
        
    elseif AIConnection then
        AIConnection:Disconnect()
        AIConnection = nil
        
        -- Clean up
        StopMoving()
        StandUp()
        BodyTargetAngle = 0
        
        if SCB then SCB("AI Control disabled") end
    end
end


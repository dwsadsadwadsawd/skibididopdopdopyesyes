-- Fly Function
local function ToggleFly()
    if St.Fly then
        if BodyVelocity then BodyVelocity:Destroy() end
        if BodyGyro then BodyGyro:Destroy() end
        BodyVelocity = nil
        BodyGyro = nil
        if Hum then Hum.PlatformStand = false end
    else
        if not Root then return end
        Hum.PlatformStand = true
        
        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        BodyGyro.P = 1e6
        BodyGyro.D = 100
        BodyGyro.CFrame = Root.CFrame
        BodyGyro.Parent = Root
        
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        BodyVelocity.Velocity = Vector3.zero
        BodyVelocity.P = 1e6
        BodyVelocity.Parent = Root
        
        local flyConnection = RunService.Heartbeat:Connect(function()
            if not St.Fly or not Root or not BodyVelocity then
                if flyConnection then flyConnection:Disconnect() end
                return
            end
            
            local moveDir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector * FlySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, FlySpeed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, FlySpeed, 0) end
            
            BodyVelocity.Velocity = moveDir
            BodyGyro.CFrame = CFrame.new(Root.Position, Root.Position + (Camera.CFrame.LookVector * 10))
        end)
        table.insert(CN, flyConnection)
    end
end

-- Noclip Function
local function ToggleNoclip()
    if St.Noclip then
        local noclipConnection = RunService.Stepped:Connect(function()
            if not St.Noclip or not Char then return end
            for _, part in ipairs(Char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
        table.insert(CN, noclipConnection)
    else
        if Char then
            for _, part in ipairs(Char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end


local function NewTab()
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 370, 1, -64)
    f.Position = UDim2.new(0, 150, 0, 42)
    f.BackgroundColor3 = CM
    f.BorderSizePixel = 0
    f.Visible = false
    f.Parent = MF
    return f
end

local function ShowTab(frame, btn, ab, tl)
    for _, f in ipairs(Tabs) do f.Visible = false end
    frame.Visible = true
    if ActBtn then
        TweenService:Create(ActBtn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
    end
    if ActAB then
        TweenService:Create(ActAB, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play()
    end
    ActBtn = btn
    ActAB = ab
    btn.BackgroundTransparency = 0
    btn.BackgroundColor3 = CC2
    TweenService:Create(ab, TweenInfo.new(0.15), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(tl, TweenInfo.new(0.15), { TextColor3 = CP }):Play()
end


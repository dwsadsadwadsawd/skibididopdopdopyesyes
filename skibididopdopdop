-- Scan for points of interest to look at
local function ScanPointsOfInterest()
    PointsOfInterest = {}
    
    -- Add other players with weapon detection
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hasWeapon = false
                local weaponName = "None"
                
                -- Check for weapons/items
                for _, itemName in ipairs(AllDetectableItems) do
                    if char:FindFirstChild(itemName) then
                        hasWeapon = true
                        weaponName = itemName
                        break
                    end
                end
                
                table.insert(PointsOfInterest, {
                    Position = char.HumanoidRootPart.Position,
                    Type = "player",
                    Name = plr.Name,
                    Priority = hasWeapon and 15 or 10,
                    HasWeapon = hasWeapon,
                    WeaponName = weaponName,
                    Player = plr
                })
            end
        end
    end
    
    -- Add large objects in the world (but avoid walls)
    for _, obj in ipairs(WS:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Size.Magnitude > 10 and obj ~= Root then
            -- Skip if it's likely a wall (thin and tall/wide)
            local size = obj.Size
            local isWall = (size.X < 2 and (size.Y > 8 or size.Z > 8)) or 
                          (size.Z < 2 and (size.Y > 8 or size.X > 8)) or
                          (size.Y < 2 and (size.X > 8 or size.Z > 8))
            
            if not isWall then
                table.insert(PointsOfInterest, {
                    Position = obj.Position,
                    Type = "object",
                    Name = obj.Name,
                    Priority = 3
                })
            end
        end
    end
    
    -- Add random points in explore radius (away from walls)
    for i = 1, 3 do -- Reduced from 5 to 3 to focus more on players/objects
        local attempts = 0
        local validPoint = nil
        
        repeat
            local testPoint = Root.Position + Vector3.new(
                math.random(-AIExploreRadius, AIExploreRadius),
                0,
                math.random(-AIExploreRadius, AIExploreRadius)
            )
            
            -- Simple wall check - raycast down to see if there's ground
            local ray = WS:Raycast(testPoint + Vector3.new(0, 5, 0), Vector3.new(0, -10, 0))
            if ray and ray.Instance then
                validPoint = testPoint
            end
            attempts = attempts + 1
        until validPoint or attempts > 5
        
        if validPoint then
            table.insert(PointsOfInterest, {
                Position = validPoint,
                Type = "random",
                Priority = 1
            })
        end
    end
end

-- Smooth look at target using body rotation
local function SmoothLookAt(targetPos, dt)
    if not Root or not targetPos then return end
    
    local direction = (targetPos - Root.Position).Unit
    local angle = math.atan2(-direction.X, -direction.Z)
    
    -- Smoothly interpolate to target angle
    BodyTargetAngle = angle
    BodyCurrentAngle = BodyCurrentAngle + (BodyTargetAngle - BodyCurrentAngle) * math.min(dt * 8, 1)
    
    -- Apply rotation
    Root.CFrame = CFrame.new(Root.Position) * CFrame.Angles(0, BodyCurrentAngle, 0)
end

-- Look around at interesting things
local function LookAround(dt)
    if #PointsOfInterest == 0 then
        ScanPointsOfInterest()
    end
    
    if AILookTimer <= 0 then
        -- Sort by priority and pick a high priority target
        table.sort(PointsOfInterest, function(a, b) return a.Priority > b.Priority end)
        local randomPoint = PointsOfInterest[math.random(1, math.min(3, #PointsOfInterest))] -- Pick from top 3
        
        if randomPoint then
            AILookTarget = randomPoint.Position
            AILookTimer = AILookDuration
            
            if randomPoint.Type == "player" then
                local weaponInfo = randomPoint.HasWeapon and (" [" .. randomPoint.WeaponName .. "]") or ""
                if SCB then SCB("Looking at " .. randomPoint.Name .. weaponInfo) end
            end
        end
    else
        AILookTimer = AILookTimer - dt
    end
    
    if AILookTarget then
        SmoothLookAt(AILookTarget, dt)
    end
end

-- Create path to target using Roblox PathfindingService
local function CreatePathTo(targetPos)
    if not Root or not targetPos then return nil end
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = false, -- Disable climbing for more predictable paths
        WaypointSpacing = 4, -- Add waypoint spacing for smoother paths
        Costs = {
            Water = 20, -- Avoid water more
        }
    })
    
    local success, errorMessage = pcall(function()
        path:ComputeAsync(Root.Position, targetPos)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        return path
    else
        if SCB then SCB("Path failed: " .. (errorMessage or "Unknown error")) end
        return nil
    end
end

-- Check if path is blocked
local function IsPathBlocked()
    if not Path or #Waypoints == 0 then return false end
    
    -- Check if current waypoint is reachable
    local currentWaypoint = Waypoints[CurrentWaypointIndex]
    if not currentWaypoint then return false end
    
    local distance = (Root.Position - currentWaypoint.Position).Magnitude
    local lastDistance = AILastWaypointDistance or distance
    
    -- If we're stuck at the same distance for too long, path might be blocked
    if math.abs(distance - lastDistance) < 0.5 and AIActionTimer > 2 then
        PathBlockedTimer = PathBlockedTimer + 0.1
        if PathBlockedTimer > PathBlockedThreshold then
            PathBlockedTimer = 0
            return true
        end
    else
        PathBlockedTimer = 0
    end
    
    AILastWaypointDistance = distance
    return false
end

-- Follow path using Humanoid:MoveTo
local function FollowPath()
    if not Path or #Waypoints == 0 then
        if Hum then Hum:MoveTo(Root.Position) end -- Stop moving
        return false
    end
    
    -- Check if we're stuck in the same position
    if AILastPosition then
        local distanceMoved = (Root.Position - AILastPosition).Magnitude
        if distanceMoved < 0.5 then
            AIStuckTimer = AIStuckTimer + 0.1
            if AIStuckTimer > 3 then -- Stuck for 3 seconds
                AIPathBlocked = true
                AIStuckTimer = 0
                if Hum then Hum:MoveTo(Root.Position) end
                return false
            end
        else
            AIStuckTimer = 0
        end
    end
    AILastPosition = Root.Position
    
    -- Check if path is blocked
    if IsPathBlocked() then
        AIPathBlocked = true
        if Hum then Hum:MoveTo(Root.Position) end -- Stop moving
        return false
    end
    
    -- Move to current waypoint
    local currentWaypoint = Waypoints[CurrentWaypointIndex]
    if currentWaypoint then
        -- Set humanoid walkspeed
        if Hum then
            Hum.WalkSpeed = AIWalkSpeed
        end
        
        Hum:MoveTo(currentWaypoint.Position)
        
        -- Check if we've reached the waypoint
        local distance = (Root.Position - currentWaypoint.Position).Magnitude
        if distance < 4 then -- Increased threshold for better reliability
            CurrentWaypointIndex = CurrentWaypointIndex + 1
            if CurrentWaypointIndex > #Waypoints then
                -- Reached end of path
                Path = nil
                Waypoints = {}
                CurrentWaypointIndex = 1
                AIStuckTimer = 0
                return true -- Reached destination
            end
        end
    end
    
    return false
end

-- Wall avoidance system
local function AvoidWalls()
    if not Root then return Vector3.zero end
    
    local avoidanceForce = Vector3.zero
    local rayDistance = 8
    
    -- Cast rays in multiple directions to detect walls
    local directions = {
        Root.CFrame.LookVector,
        Root.CFrame.RightVector,
        -Root.CFrame.RightVector,
        (Root.CFrame.LookVector + Root.CFrame.RightVector).Unit,
        (Root.CFrame.LookVector - Root.CFrame.RightVector).Unit
    }
    
    for _, direction in ipairs(directions) do
        local ray = WS:Raycast(Root.Position + Vector3.new(0, 2, 0), direction * rayDistance)
        if ray and ray.Instance then
            local distance = ray.Distance
            if distance < rayDistance then
                -- Add force away from the wall
                local avoidDirection = -direction
                local strength = (rayDistance - distance) / rayDistance
                avoidanceForce = avoidanceForce + avoidDirection * strength * 10
            end
        end
    end
    
    return avoidanceForce
end

-- Improved walk to target with wall avoidance
local function WalkToTargetImproved(targetPos, dt)
    if not Root or not targetPos or not Hum then return false end
    
    local distance = (targetPos - Root.Position).Magnitude
    
    -- Wall avoidance
    local avoidanceForce = AvoidWalls()
    if avoidanceForce.Magnitude > 0 then
        AIWallAvoidanceTimer = AIWallAvoidanceTimer + dt
        if AIWallAvoidanceTimer > 0.5 then -- Avoid walls for at least 0.5 seconds
            local avoidanceTarget = Root.Position + avoidanceForce.Unit * 10
            if Hum then
                Hum.WalkSpeed = AIWalkSpeed * 0.8
                Hum:MoveTo(avoidanceTarget)
            end
            if SCB then SCB("Avoiding walls...") end
            return false
        end
    else
        AIWallAvoidanceTimer = 0
    end
    
    -- If very close, just move directly
    if distance < 8 then
        if Hum then
            Hum.WalkSpeed = AIWalkSpeed
            Hum:MoveTo(targetPos)
        end
        SmoothLookAt(targetPos, dt)
        return distance <= 3
    end
    
    -- Update path periodically or when we don't have one
    local currentTime = tick()
    if currentTime - LastPathUpdate > PathUpdateInterval or not Path or AIPathBlocked then
        Path = CreatePathTo(targetPos)
        LastPathUpdate = currentTime
        
        if Path then
            Waypoints = Path:GetWaypoints()
            CurrentWaypointIndex = 1
            AIPathBlocked = false
            AIStuckTimer = 0
            AILastPosition = Root.Position
            if SCB then SCB("New path created with " .. #Waypoints .. " waypoints") end
        else
            -- No path found, try direct movement for a bit
            AIPathBlocked = true
            if Hum then
                Hum.WalkSpeed = AIWalkSpeed
                Hum:MoveTo(targetPos)
            end
            if SCB then SCB("No path found - trying direct movement") end
        end
    end
    
    -- Follow path if it exists and isn't blocked
    if Path and not AIPathBlocked then
        local reached = FollowPath()
        if reached then
            return true
        end
    else
        -- Path blocked or no path, try direct movement briefly
        if Hum then
            Hum.WalkSpeed = AIWalkSpeed
            Hum:MoveTo(targetPos)
        end
        LookAround(dt)
    end
    
    -- Always look in the direction we're trying to go
    if not AIPathBlocked and AIWallAvoidanceTimer <= 0 then
        SmoothLookAt(targetPos, dt)
    end
    
    return false
end


local function CreatePlayerSelector(parent, y)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -16, 0, 150)
    frame.Position = UDim2.new(0, 8, 0, y)
    frame.BackgroundColor3 = CC
    frame.BorderSizePixel = 0
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = CB
    stroke.Thickness = 1
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = CC2
    title.BorderSizePixel = 0
    title.Text = "Target Player"
    title.TextColor3 = CP
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.Parent = frame
    Instance.new("UICorner", title).CornerRadius = UDim.new(0, 6)
    
    -- Search bar
    local searchFrame = Instance.new("Frame")
    searchFrame.Size = UDim2.new(1, -20, 0, 30)
    searchFrame.Position = UDim2.new(0, 10, 0, 35)
    searchFrame.BackgroundColor3 = CC2
    searchFrame.BorderSizePixel = 0
    searchFrame.Parent = frame
    Instance.new("UICorner", searchFrame).CornerRadius = UDim.new(0, 6)
    
    local searchIcon = Instance.new("TextLabel")
    searchIcon.Size = UDim2.new(0, 30, 1, 0)
    searchIcon.Position = UDim2.new(0, 0, 0, 0)
    searchIcon.BackgroundTransparency = 1
    searchIcon.Text = "🔍"
    searchIcon.TextColor3 = CSC
    searchIcon.Font = Enum.Font.Gotham
    searchIcon.TextSize = 14
    searchIcon.Parent = searchFrame
    
    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, -30, 1, 0)
    searchBox.Position = UDim2.new(0, 30, 0, 0)
    searchBox.BackgroundTransparency = 1
    searchBox.PlaceholderText = "Search player..."
    searchBox.PlaceholderColor3 = CIT
    searchBox.Text = ""
    searchBox.TextColor3 = CP
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 12
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchFrame
    
    -- Player list
    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, -20, 1, -70)
    listFrame.Position = UDim2.new(0, 10, 0, 70)
    listFrame.BackgroundTransparency = 1
    listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 4
    listFrame.ScrollBarImageColor3 = CA
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.Parent = frame
    
    local layout = Instance.new("UIListLayout", listFrame)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 2)
    
    local function UpdatePlayerList()
        -- Clear existing
        for _, child in ipairs(listFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end
        
        local searchText = searchBox.Text:lower()
        local players = GetPlayers()
        
        table.sort(players, function(a, b)
            return a.Name < b.Name
        end)
        
        for _, plr in ipairs(players) do
            if searchText == "" or plr.Name:lower():find(searchText, 1, true) then
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, 0, 0, 28)
                btn.BackgroundColor3 = CC2
                btn.BorderSizePixel = 0
                btn.Text = plr.Name
                btn.TextColor3 = GetPlayerColor(plr)
                btn.Font = Enum.Font.Gotham
                btn.TextSize = 12
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = listFrame
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
                
                local padding = Instance.new("UIPadding", btn)
                padding.PaddingLeft = UDim.new(0, 6)
                
                btn.MouseEnter:Connect(function()
                    btn.BackgroundColor3 = CO
                end)
                
                btn.MouseLeave:Connect(function()
                    btn.BackgroundColor3 = CC2
                end)
                
                btn.MouseButton1Click:Connect(function()
                    SelectedTarget = plr
                    if SCB then SCB("Target: " .. plr.Name) end
                    
                    for _, b in ipairs(listFrame:GetChildren()) do
                        if b:IsA("TextButton") then
                            b.BackgroundColor3 = CC2
                        end
                    end
                    btn.BackgroundColor3 = CA
                end)
            end
        end
        
        listFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
    end
    
    searchBox.Changed:Connect(function(prop)
        if prop == "Text" then
            UpdatePlayerList()
        end
    end)
    
    UpdatePlayerList()
    
    -- Refresh every 5 seconds
    task.spawn(function()
        while true do
            task.wait(5)
            UpdatePlayerList()
        end
    end)
    
    return frame
end


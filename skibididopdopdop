-- Fake Lag
local function ToggleFakeLag()
    if St.FakeLag then
        FakeLagConnection = RunService.Heartbeat:Connect(function()
            if not St.FakeLag then return end
            wait(LagInterval)
        end)
        table.insert(CN, FakeLagConnection)
    elseif FakeLagConnection then
        FakeLagConnection:Disconnect()
        FakeLagConnection = nil
    end
end

-- Wifi Lag (teleport back and forth)
local function ToggleWifiLag()
    if St.WifiLag then
        local lastPos = Root and Root.Position
        WifiLagConnection = RunService.Heartbeat:Connect(function()
            if not St.WifiLag or not Root then return end
            
            if lastPos and math.random() < 0.3 then -- 30% chance to lag
                Root.CFrame = CFrame.new(lastPos + Vector3.new(
                    math.random(-WifiLagStrength, WifiLagStrength),
                    math.random(-WifiLagStrength, WifiLagStrength),
                    math.random(-WifiLagStrength, WifiLagStrength)
                ))
            end
            lastPos = Root.Position
        end)
        table.insert(CN, WifiLagConnection)
    elseif WifiLagConnection then
        WifiLagConnection:Disconnect()
        WifiLagConnection = nil
    end
end

-- Anchor Interval (alternate anchored state)
local function ToggleAnchorInterval()
    if St.AnchorInterval then
        local anchored = false
        AnchorIntervalConnection = RunService.Heartbeat:Connect(function()
            if not St.AnchorInterval or not Root then return end
            
            anchored = not anchored
            Root.Anchored = anchored
            wait(AnchorIntervalTime)
        end)
        table.insert(CN, AnchorIntervalConnection)
    elseif AnchorIntervalConnection then
        AnchorIntervalConnection:Disconnect()
        AnchorIntervalConnection = nil
        if Root then Root.Anchored = false end
    end
end

-- SpinBot

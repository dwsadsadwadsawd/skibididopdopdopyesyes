-- ==============================================
-- ANCHOR INTERVAL
-- ==============================================
local function ToggleAnchorInterval()
    if St.AnchorInterval then
        local slowed = false
        
        AnchorBodyVelocity = Instance.new("BodyVelocity")
        AnchorBodyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        AnchorBodyVelocity.P = 1e6
        AnchorBodyVelocity.Velocity = Vector3.zero
        AnchorBodyVelocity.Parent = Root
        
        AnchorIntervalConnection = RunService.Heartbeat:Connect(function()
            if not St.AnchorInterval or not Root then return end
            
            slowed = not slowed
            
            if slowed then
                -- When in "slow mode", use BodyVelocity
                local moveDir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                
                if moveDir.Magnitude > 0 then
                    AnchorBodyVelocity.Velocity = moveDir.Unit * (16 * AnchorSlowMultiplier)
                else
                    AnchorBodyVelocity.Velocity = Vector3.zero
                end
            else
                -- When in normal mode, stop BodyVelocity
                AnchorBodyVelocity.Velocity = Vector3.zero
            end
            
            wait(AnchorIntervalSpeed)
        end)
        table.insert(CN, AnchorIntervalConnection)
        
    elseif AnchorIntervalConnection then
        AnchorIntervalConnection:Disconnect()
        AnchorIntervalConnection = nil
        if AnchorBodyVelocity then
            AnchorBodyVelocity:Destroy()
            AnchorBodyVelocity = nil
        end
    end
end

-- ==============================================
-- CREEPY PASTA HEAD MODE (Only head moves, stays in position)
-- ==============================================
local function ToggleCreepyPastaHead()
    if St.CreepyPastaHead then
        -- Find neck joint for head turning
        local neck = Char:FindFirstChild("Head") and Char.Head:FindFirstChild("Neck")
        
        if not neck then
            if SCB then SCB("No neck joint found - can't use head mode") end
            St.CreepyPastaHead = false
            return
        end
        
        -- Key tracking variables
        local ePressed = false
        local qPressed = false
        local lastETime = 0
        local lastQTime = 0
        
        -- Input handlers
        local function onInputBegan(input, gameProcessed)
            if gameProcessed then return end
            
            if input.KeyCode == Enum.KeyCode.E then
                ePressed = true
                lastETime = tick()
                -- Single increment on press
                HeadAngle = HeadAngle + HeadAngleIncrement
            elseif input.KeyCode == Enum.KeyCode.Q then
                qPressed = true
                lastQTime = tick()
                -- Single increment on press
                HeadAngle = HeadAngle - HeadAngleIncrement
            end
        end
        
        local function onInputEnded(input, gameProcessed)
            if gameProcessed then return end
            
            if input.KeyCode == Enum.KeyCode.E then
                ePressed = false
            elseif input.KeyCode == Enum.KeyCode.Q then
                qPressed = false
            end
        end
        
        -- Connect input handlers
        local inputBeganConn = UserInputService.InputBegan:Connect(onInputBegan)
        local inputEndedConn = UserInputService.InputEnded:Connect(onInputEnded)
        table.insert(CN, inputBeganConn)
        table.insert(CN, inputEndedConn)
        
        -- Continuous movement when holding
        local holdConnection = RunService.Heartbeat:Connect(function(dt)
            if not St.CreepyPastaHead then return end
            
            local currentTime = tick()
            
            -- E key held continuous movement
            if ePressed and (currentTime - lastETime) > KeyHoldThreshold then
                HeadAngle = HeadAngle + HeadAngleIncrement * (dt * 30) -- Scale by delta time
                lastETime = currentTime
            end
            
            -- Q key held continuous movement
            if qPressed and (currentTime - lastQTime) > KeyHoldThreshold then
                HeadAngle = HeadAngle - HeadAngleIncrement * (dt * 30) -- Scale by delta time
                lastQTime = currentTime
            end
            
            -- Apply head rotation
            if neck then
                neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(0, HeadAngle, 0)
            end
        end)
        table.insert(CN, holdConnection)
        
        if SCB then SCB("Head Mode: Use E/Q to move head (stays in place)") end
        
    elseif CreepyPastaHeadConnection then
        CreepyPastaHeadConnection:Disconnect()
        CreepyPastaHeadConnection = nil
        
        -- Reset head to neutral
        local neck = Char:FindFirstChild("Head") and Char.Head:FindFirstChild("Neck")
        if neck then
            neck.C0 = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, 0)
        end
        
        HeadAngle = 0
        if SCB then SCB("Head Mode disabled") end
    end
end

-- ==============================================
-- CREEPY PASTA BODY MODE (Whole body rotates, stays in position)
-- ==============================================
local function ToggleCreepyPastaBody()
    if St.CreepyPastaBody then
        -- Key tracking variables
        local ePressed = false
        local qPressed = false
        local lastETime = 0
        local lastQTime = 0
        
        -- Input handlers
        local function onInputBegan(input, gameProcessed)
            if gameProcessed then return end
            
            if input.KeyCode == Enum.KeyCode.E then
                ePressed = true
                lastETime = tick()
                -- Single increment on press
                BodyAngle = BodyAngle + BodyAngleIncrement
            elseif input.KeyCode == Enum.KeyCode.Q then
                qPressed = true
                lastQTime = tick()
                -- Single increment on press
                BodyAngle = BodyAngle - BodyAngleIncrement
            end
        end
        
        local function onInputEnded(input, gameProcessed)
            if gameProcessed then return end
            
            if input.KeyCode == Enum.KeyCode.E then
                ePressed = false
            elseif input.KeyCode == Enum.KeyCode.Q then
                qPressed = false
            end
        end
        
        -- Connect input handlers
        local inputBeganConn = UserInputService.InputBegan:Connect(onInputBegan)
        local inputEndedConn = UserInputService.InputEnded:Connect(onInputEnded)
        table.insert(CN, inputBeganConn)
        table.insert(CN, inputEndedConn)
        
        -- Continuous movement when holding
        local holdConnection = RunService.Heartbeat:Connect(function(dt)
            if not St.CreepyPastaBody or not Root then return end
            
            local currentTime = tick()
            
            -- E key held continuous movement
            if ePressed and (currentTime - lastETime) > KeyHoldThreshold then
                BodyAngle = BodyAngle + BodyAngleIncrement * (dt * 30)
                lastETime = currentTime
            end
            
            -- Q key held continuous movement
            if qPressed and (currentTime - lastQTime) > KeyHoldThreshold then
                BodyAngle = BodyAngle - BodyAngleIncrement * (dt * 30)
                lastQTime = currentTime
            end
            
            -- Apply body rotation while preserving position
            local currentPos = Root.Position
            Root.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, BodyAngle, 0)
        end)
        table.insert(CN, holdConnection)
        
        if SCB then SCB("Body Mode: Use E/Q to rotate body (stays in place)") end
        
    elseif CreepyPastaBodyConnection then
        CreepyPastaBodyConnection:Disconnect()
        CreepyPastaBodyConnection = nil
        
        BodyAngle = 0
        if SCB then SCB("Body Mode disabled") end
    end
end


-- Set AI Mode
local function SetAIMode(mode)
    AIMode = mode
    AIState = "idle"
    StopMoving()
    StandUp()
    Path = nil
    Waypoints = {}
    AIPathBlocked = false
    AIStuckTimer = 0
    AILastPosition = nil
    AIActionTimer = 0
    ScanPointsOfInterest()
    
    if mode == "explore" then
        if SCB then SCB("Mode: Explore - Wandering and looking around") end
    elseif mode == "follow" then
        if AITargetPlayer then
            if SCB then SCB("Mode: Follow - Following " .. AITargetPlayer.Name) end
        else
            if SCB then SCB("Mode: Follow - Select a player first") end
        end
    elseif mode == "hide" then
        if SCB then SCB("Mode: Hide - Finding places to hide") end
    elseif mode == "sit" then
        if SCB then SCB("Mode: Sit - Looking for sitting players") end
    elseif mode == "flee" then
        AIFleeTimer = AIFleeDuration
        if SCB then SCB("Mode: Flee - Running away!") end
    elseif mode == "defend" then
        if AIDefendTarget then
            if SCB then SCB("Mode: Defend - Protecting " .. AIDefendTarget.Name) end
        else
            if SCB then SCB("Mode: Defend - Select a player to defend first") end
        end
    end
end

-- Toggle AI Control
local function ToggleAIControl()
    if St.AIControl then
        -- Disable conflicting features
        if St.Fly then
            St.Fly = false
            ToggleFly()
        end
        if St.Float then
            St.Float = false
            ToggleFloat()
        end
        
        -- Reset humanoid state
        if Hum then
            Hum.PlatformStand = false
            Hum.WalkSpeed = 16
        end
        
        -- Initialize AI
        ScanPointsOfInterest()
        SetAIMode("explore")
        
        -- Main AI loop
        AIConnection = RunService.Heartbeat:Connect(function(dt)
            UpdateAI(dt)
        end)
        table.insert(CN, AIConnection)
        
        if SCB then SCB("AI Control enabled - Mode: Explore") end
        
    elseif AIConnection then
        AIConnection:Disconnect()
        AIConnection = nil
        
        -- Clean up
        StopMoving()
        StandUp()
        BodyTargetAngle = 0
        Path = nil
        
        if SCB then SCB("AI Control disabled") end
    end
end


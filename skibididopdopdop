-- ==============================================
-- SIMPLE ANCHOR INTERVAL (Slows you down)
-- ==============================================
local function ToggleAnchorInterval()
    if St.AnchorInterval then
        local anchored = false
        local originalWalkSpeed = 16
        
        AnchorIntervalConnection = RunService.Heartbeat:Connect(function()
            if not St.AnchorInterval or not Root then return end
            
            anchored = not anchored
            Root.Anchored = anchored
            
            -- Slow down when anchored
            if anchored and Hum then
                Hum.WalkSpeed = Hum.WalkSpeed * AnchorSlowAmount
            elseif not anchored and Hum then
                -- Restore speed when unanchored
                if St.Walkspeed then
                    Hum.WalkSpeed = WalkSpeedValue
                else
                    Hum.WalkSpeed = 16
                end
            end
            
            wait(AnchorIntervalSpeed)
        end)
        table.insert(CN, AnchorIntervalConnection)
        
    elseif AnchorIntervalConnection then
        AnchorIntervalConnection:Disconnect()
        AnchorIntervalConnection = nil
        if Root then Root.Anchored = false end
        -- Restore speed
        if Hum then
            if St.Walkspeed then
                Hum.WalkSpeed = WalkSpeedValue
            else
                Hum.WalkSpeed = 16
            end
        end
    end
end


local function NTog(p, y, label, key, cb)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -16, 0, 36)
    Row.Position = UDim2.new(0, 8, 0, y)
    Row.BackgroundColor3 = CC
    Row.BorderSizePixel = 0
    Row.Parent = p
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 6)

    local rs = Instance.new("UIStroke", Row)
    rs.Color = CB
    rs.Thickness = 1

    local Lb = Instance.new("TextLabel")
    Lb.Text = label
    Lb.Size = UDim2.new(1, -58, 1, 0)
    Lb.Position = UDim2.new(0, 12, 0, 0)
    Lb.BackgroundTransparency = 1
    Lb.TextColor3 = CP
    Lb.Font = Enum.Font.GothamMedium
    Lb.TextSize = 13
    Lb.TextXAlignment = Enum.TextXAlignment.Left
    Lb.Parent = Row

    local Tog = Instance.new("TextButton")
    Tog.Size = UDim2.new(0, 34, 0, 18)
    Tog.Position = UDim2.new(1, -46, 0.5, -9)
    Tog.BackgroundColor3 = CO
    Tog.BorderSizePixel = 0
    Tog.Text = ""
    Tog.AutoButtonColor = false
    Tog.Parent = Row
    Instance.new("UICorner", Tog).CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.new(0, 12, 0, 12)
    Dot.Position = UDim2.new(0, 3, 0.5, -6)
    Dot.BackgroundColor3 = CD
    Dot.BorderSizePixel = 0
    Dot.Parent = Tog
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    local function Vis(on)
        TweenService:Create(Tog, TweenInfo.new(0.18), { BackgroundColor3 = on and CA or CO }):Play()
        TweenService:Create(Dot, TweenInfo.new(0.18), {
            Position = on and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
            BackgroundColor3 = on and CW or CD
        }):Play()
    end

    Tog.MouseButton1Click:Connect(function()
        if key then
            St[key] = not St[key]
            Vis(St[key])
            if cb then cb(St[key]) end
        end
    end)

    -- Set initial state
    if St[key] then Vis(true) end
end

local function NSlider(p, y, label, min, max, default, callback)
    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(1, -16, 0, 58)
    Card.Position = UDim2.new(0, 8, 0, y)
    Card.BackgroundColor3 = CC
    Card.BorderSizePixel = 0
    Card.Parent = p
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", Card)
    stroke.Color = CB
    stroke.Thickness = 1

    local Lbl = Instance.new("TextLabel")
    Lbl.Text = label
    Lbl.Size = UDim2.new(0.55, 0, 0, 24)
    Lbl.Position = UDim2.new(0, 12, 0, 2)
    Lbl.BackgroundTransparency = 1
    Lbl.TextColor3 = CP
    Lbl.Font = Enum.Font.GothamMedium
    Lbl.TextSize = 13
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.Parent = Card

    local Val = Instance.new("TextLabel")
    Val.Text = tostring(default)
    Val.Size = UDim2.new(0.45, -12, 0, 24)
    Val.Position = UDim2.new(0.55, 0, 0, 2)
    Val.BackgroundTransparency = 1
    Val.TextColor3 = CA
    Val.Font = Enum.Font.GothamBold
    Val.TextSize = 13
    Val.TextXAlignment = Enum.TextXAlignment.Right
    Val.Parent = Card

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, -24, 0, 6)
    Track.Position = UDim2.new(0, 12, 0, 38)
    Track.BackgroundColor3 = CB
    Track.BorderSizePixel = 0
    Track.Parent = Card
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local initFrac = (default - min) / (max - min)
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(initFrac, 0, 1, 0)
    Fill.BackgroundColor3 = CA
    Fill.BorderSizePixel = 0
    Fill.Parent = Track
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Thumb = Instance.new("TextButton")
    Thumb.Size = UDim2.new(0, 16, 0, 16)
    Thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    Thumb.Position = UDim2.new(initFrac, 0, 0.5, 0)
    Thumb.BackgroundColor3 = CW
    Thumb.BorderSizePixel = 0
    Thumb.Text = ""
    Thumb.AutoButtonColor = false
    Thumb.Parent = Track
    Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local value = default

    local function UpdateSlider(xPos)
        local rel = (xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        value = min + (rel * (max - min))
        -- Round to 2 decimal places for lag interval
        if min < 1 then
            value = math.floor(value * 100) / 100
        else
            value = math.floor(value)
        end
        Fill.Size = UDim2.new(rel, 0, 1, 0)
        Thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        Val.Text = tostring(value)
        if callback then callback(value) end
    end

    Thumb.MouseButton1Down:Connect(function()
        dragging = true
    end)

    Track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            UpdateSlider(i.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            UpdateSlider(i.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return Card
end


-- ==============================================
-- WIFI LAG (Simple teleport lag)
-- ==============================================
local function ToggleWifiLag()
    if St.WifiLag then
        WifiLagConnection = RunService.Heartbeat:Connect(function()
            if not St.WifiLag or not Root then return end
            
            if math.random() < 0.3 then
                local offset = Vector3.new(
                    math.random(-WifiLagStrength, WifiLagStrength),
                    math.random(-WifiLagStrength/2, WifiLagStrength/2),
                    math.random(-WifiLagStrength, WifiLagStrength)
                )
                Root.CFrame = CFrame.new(Root.Position + offset)
            end
        end)
        table.insert(CN, WifiLagConnection)
    elseif WifiLagConnection then
        WifiLagConnection:Disconnect()
        WifiLagConnection = nil
    end
end


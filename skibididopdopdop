-- Scan for points of interest
local function ScanForPoints()
    InterestPoints = {}
    
    -- Add other players as points of interest
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                table.insert(InterestPoints, {
                    Position = char.HumanoidRootPart.Position,
                    Type = "player",
                    Player = plr
                })
            end
        end
    end
    
    -- Add random points in the world (simplified - would need actual map data)
    -- For demo, we'll just add some random offsets from current position
    for i = 1, 5 do
        table.insert(InterestPoints, {
            Position = Root.Position + Vector3.new(
                math.random(-AIScanRadius, AIScanRadius),
                0,
                math.random(-AIScanRadius, AIScanRadius)
            ),
            Type = "random"
        })
    end
end

-- Check if someone is sitting nearby
local function CheckForSitting()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum and hum.Sit then
                    local rootPart = char:FindFirstChild("HumanoidRootPart")
                    if rootPart and (rootPart.Position - Root.Position).Magnitude < AISitDetectionRange then
                        return plr, rootPart.Position
                    end
                end
            end
        end
    end
    return nil
end


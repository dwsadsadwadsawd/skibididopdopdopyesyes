-- ESP Functions
local function GetPlayerColor(plr)
    local team = plr.Team
    if team and team.TeamColor then
        return team.TeamColor.Color
    end
    return CA
end

local function CreateESP(plr)
    if EO[plr] then return end
    
    local char = GetCharacter(plr)
    local root = GetRoot(plr)
    if not char or not root then return end
    
    local color = GetPlayerColor(plr)
    local espData = {}
    
    if St.ESP then
        -- Billboard GUI
        local bb = Instance.new("BillboardGui")
        bb.Name = "UniversalESP"
        bb.Size = UDim2.new(0, 150, 0, 50)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = root
        
        local frame = Instance.new("Frame", bb)
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = CBL
        frame.BackgroundTransparency = 0.3
        frame.BorderSizePixel = 0
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
        
        local nameLabel = Instance.new("TextLabel", frame)
        nameLabel.Size = UDim2.new(1, -4, 0.5, -2)
        nameLabel.Position = UDim2.new(0, 2, 0, 2)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = color
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3 = CBL
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        
        local distLabel = Instance.new("TextLabel", frame)
        distLabel.Size = UDim2.new(1, -4, 0.5, -2)
        distLabel.Position = UDim2.new(0, 2, 0.5, 0)
        distLabel.BackgroundTransparency = 1
        distLabel.Text = "Distance: 0"
        distLabel.TextColor3 = CP
        distLabel.TextStrokeTransparency = 0
        distLabel.TextStrokeColor3 = CBL
        distLabel.Font = Enum.Font.Gotham
        distLabel.TextSize = 11
        
        espData.bb = bb
        espData.nameLabel = nameLabel
        espData.distLabel = distLabel
    end
    
    if St.Chams then
        local highlight = Instance.new("Highlight")
        highlight.Name = "UniversalChams"
        highlight.FillColor = color
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = CW
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        espData.highlight = highlight
    end
    
    if St.Tracers then
        local tracerConnection = RunService.RenderStepped:Connect(function()
            if not St.Tracers or not root or not Camera then
                if tracerConnection then tracerConnection:Disconnect() end
                return
            end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                -- Draw tracer logic here (would require Drawing library which may not be available)
            end
        end)
        espData.tracerConnection = tracerConnection
        table.insert(CN, tracerConnection)
    end
    
    -- Distance updater
    local distConnection = RunService.Heartbeat:Connect(function()
        if not St.ESP or not root or not Root or not espData.distLabel then
            if distConnection then distConnection:Disconnect() end
            return
        end
        local dist = (root.Position - Root.Position).Magnitude
        espData.distLabel.Text = string.format("Distance: %.1f", dist)
    end)
    espData.distConnection = distConnection
    table.insert(CN, distConnection)
    
    EO[plr] = espData
end

local function RemoveESP(plr)
    local espData = EO[plr]
    if not espData then return end
    
    if espData.bb then espData.bb:Destroy() end
    if espData.highlight then espData.highlight:Destroy() end
    if espData.tracerConnection then espData.tracerConnection:Disconnect() end
    if espData.distConnection then espData.distConnection:Disconnect() end
    
    EO[plr] = nil
end

local function RefreshESP()
    -- Clean up invalid
    for plr in pairs(EO) do
        if not plr or not plr.Parent then
            RemoveESP(plr)
        end
    end
    
    -- Toggle based on states
    if not St.ESP and not St.Chams and not St.Tracers then
        for plr in pairs(EO) do
            RemoveESP(plr)
        end
        return
    end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            CreateESP(plr)
        end
    end
end

